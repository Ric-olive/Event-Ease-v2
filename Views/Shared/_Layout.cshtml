<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Event Ease</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Event_Ease.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg main-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-calendar-check-fill navbar-brand-icon"></i>
                    Event Ease
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" 
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" && ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "active" : "")" 
                               asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <div class="nav-item-divider d-none d-lg-block"></div>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Venues" ? "active" : "")" 
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-building me-1"></i> Venues
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Venues" asp-action="List">
                                        <i class="bi bi-grid-3x3-gap"></i> Browse Venues
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Venues" asp-action="Add">
                                        <i class="bi bi-plus-circle"></i> Add New Venue
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <div class="nav-item-divider d-none d-lg-block"></div>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Events" ? "active" : "")" 
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-calendar-event me-1"></i> Events
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Events" asp-action="List">
                                        <i class="bi bi-card-list"></i> Browse Events
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Events" asp-action="Add">
                                        <i class="bi bi-plus-circle"></i> Create Event
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="EventTypes" asp-action="Index">
                                        <i class="bi bi-tags"></i> Manage Event Types
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <div class="nav-item-divider d-none d-lg-block"></div>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Bookings" ? "active" : "")" 
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-bookmark-check me-1"></i> Bookings
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Bookings" asp-action="List">
                                        <i class="bi bi-list-check"></i> My Bookings
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Bookings" asp-action="Add">
                                        <i class="bi bi-plus-circle"></i> New Booking
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" && ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "container-fluid container-wide" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <div class="footer-brand">Event Ease</div>
                    <p>Simplifying event planning and venue management with an intuitive, all-in-one platform.</p>
                    <div class="footer-social mt-4">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Twitter"><i class="bi bi-twitter"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-md-4 col-lg-2 mb-4 mb-md-0">
                    <h5 class="footer-links-title">Quick Links</h5>
                    <ul class="footer-links">
                        <li><a href="/"><i class="bi bi-chevron-right"></i> Home</a></li>
                        <li><a href="/Venues/List"><i class="bi bi-chevron-right"></i> Venues</a></li>
                        <li><a href="/Events/List"><i class="bi bi-chevron-right"></i> Events</a></li>
                        <li><a href="/Bookings/List"><i class="bi bi-chevron-right"></i> Bookings</a></li>
                    </ul>
                </div>
                <div class="col-md-4 col-lg-3 mb-4 mb-md-0">
                    <h5 class="footer-links-title">Resources</h5>
                    <ul class="footer-links">
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Event Planning Guide</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Venue Selection Tips</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> FAQs</a></li>
                        <li><a href="#"><i class="bi bi-chevron-right"></i> Blog</a></li>
                    </ul>
                </div>
                <div class="col-md-4 col-lg-3">
                    <h5 class="footer-links-title">Contact Us</h5>
                    <ul class="footer-links">
                        <li><a href="mailto:info@eventease.com"><i class="bi bi-envelope"></i> info@eventease.com</a></li>
                        <li><a href="tel:+12345678900"><i class="bi bi-telephone"></i> +1 (234) 567-8900</a></li>
                        <li><a href="#"><i class="bi bi-geo-alt"></i> 123 Event Street, New York, NY</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p class="mb-0">&copy; @DateTime.Now.Year - Event Ease - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a> - <a href="#">Terms of Service</a></p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Add dynamic active class to navbar items based on current page
        document.addEventListener("DOMContentLoaded", function() {
            // Highlight current nav item
            const currentLocation = window.location.pathname;
            
            // Handle dropdown active states
            const navLinks = document.querySelectorAll('.nav-link.dropdown-toggle');
            navLinks.forEach(link => {
                const controller = link.getAttribute('href').toLowerCase();
                if (currentLocation.includes(controller)) {
                    link.classList.add('active');
                }
            });
        });
    </script>
</body>
</html>