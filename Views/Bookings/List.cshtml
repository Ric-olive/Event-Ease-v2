@model List<Event_Ease.Models.Entities.Booking>

<div class="bookings-container">
    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="bookings-header">
        <div class="container">
            <h1>Your Event Bookings</h1>
            <p>Manage all your event reservations in one place</p>
            <a href="/Bookings/Add" class="btn btn-light mt-3">
                <i class="bi bi-plus-circle me-2"></i>Create New Booking
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="container mb-4">
        <div class="filter-container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="bookingSearchInput" class="form-control" placeholder="Search by event name">
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-geo-alt"></i>
                        </span>
                        <select id="venueFilter" class="form-control">
                            <option value="" selected>All Venues</option>
                            @{
                                var venues = Model
                                    .Where(b => b.Venue != null)
                                    .Select(b => b.Venue.VenueName)
                                    .Distinct()
                                    .ToList();
                                
                                foreach (var venue in venues)
                                {
                                    <option value="@venue">@venue</option>
                                }
                            }
                            <option value="no-venue">No Venue Selected</option>
                        </select>
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-calendar-date"></i>
                        </span>
                        <select id="bookingDateFilter" class="form-control">
                            <option value="" selected>All Booking Dates</option>
                            <option value="today">Today</option>
                            <option value="this-week">This Week</option>
                            <option value="this-month">This Month</option>
                            <option value="last-month">Last Month</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bookings Table Section -->
    <div class="container">
        <div class="bookings-table-container">
            <table class="bookings-table" id="bookingsTable">
                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Venue</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var booking in Model)
                        {
                            <tr class="booking-item" 
                                data-name="@booking.Event.EventName.ToLower()" 
                                data-venue="@(booking.Venue != null ? booking.Venue.VenueName : "no-venue")"
                                data-booking-date="@booking.BookingDate.ToString("yyyy-MM-dd")">
                                <td class="booking-event-name">@booking.Event.EventName</td>
                                <td class="booking-date">
                                    <i class="bi bi-calendar2-check me-2"></i>
                                    @booking.Event.EventStartDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="booking-date">
                                    <i class="bi bi-calendar2-x me-2"></i>
                                    @booking.Event.EventEndDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="booking-venue">
                                    @if (booking.Venue != null)
                                    {
                                        <i class="bi bi-geo-alt me-2"></i>
                                        @booking.Venue.VenueName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="bi bi-x-circle me-2"></i>
                                            No Venue Selected
                                        </span>
                                    }
                                </td>
                                <td class="booking-date">
                                    <i class="bi bi-calendar-check me-2"></i>
                                    @booking.BookingDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="booking-actions">
                                    <a asp-controller="Bookings" asp-action="Edit" asp-route-id="@booking.BookingID" class="btn-booking-edit">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <form asp-controller="Bookings" asp-action="Delete" asp-route-id="@booking.BookingID" method="post" onsubmit="return confirm('Are you sure you want to delete this booking?');">
                                        <button type="submit" class="btn-booking-delete">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-calendar-x" style="font-size: 3rem; color: #6c757d;"></i>
                                <h4 class="mt-3">No Bookings Found</h4>
                                <p class="text-muted">Create your first booking to get started</p>
                                <a href="/Bookings/Add" class="btn btn-primary mt-2">
                                    <i class="bi bi-plus-circle me-2"></i>Add First Booking
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Floating Add Button -->
    <a href="/Bookings/Add" class="add-booking-btn" title="Add New Booking">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('bookingSearchInput');
        const venueFilter = document.getElementById('venueFilter');
        const dateFilter = document.getElementById('bookingDateFilter');
        const bookingItems = document.querySelectorAll('.booking-item');
        
        function filterBookings() {
            const searchTerm = searchInput.value.toLowerCase();
            const venueValue = venueFilter.value;
            const dateValue = dateFilter.value;
            const today = new Date().toISOString().split('T')[0];
            
            bookingItems.forEach(item => {
                const name = item.dataset.name;
                const venue = item.dataset.venue;
                const bookingDate = item.dataset.bookingDate;
                
                let showBySearch = name.includes(searchTerm);
                let showByVenue = venueValue === '' || venue === venueValue;
                let showByDate = true;
                
                // Date filtering logic
                if (dateValue === 'today') {
                    showByDate = bookingDate === today;
                } else if (dateValue === 'this-week') {
                    const currentDate = new Date();
                    const lastWeek = new Date(currentDate.getFullYear(), currentDate.getMonth(), currentDate.getDate() - 7);
                    const bookingDateObj = new Date(bookingDate);
                    showByDate = bookingDateObj >= lastWeek && bookingDateObj <= currentDate;
                } else if (dateValue === 'this-month') {
                    const currentDate = new Date();
                    const firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
                    const bookingDateObj = new Date(bookingDate);
                    showByDate = bookingDateObj >= firstDayOfMonth && bookingDateObj <= currentDate;
                } else if (dateValue === 'last-month') {
                    const currentDate = new Date();
                    const firstDayOfLastMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1);
                    const lastDayOfLastMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 0);
                    const bookingDateObj = new Date(bookingDate);
                    showByDate = bookingDateObj >= firstDayOfLastMonth && bookingDateObj <= lastDayOfLastMonth;
                }
                
                if (showBySearch && showByVenue && showByDate) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }
        
        searchInput.addEventListener('input', filterBookings);
        venueFilter.addEventListener('change', filterBookings);
        dateFilter.addEventListener('change', filterBookings);
    });
</script>