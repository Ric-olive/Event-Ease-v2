@model Event_Ease.Models.ViewModels.AddBookingViewModel

<head>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</head>

<div class="container">
    <div class="booking-form-container">
        <div class="booking-form-header">
            <h2><i class="bi bi-calendar-plus me-2"></i>Create New Booking</h2>
        </div>
        
        <div class="booking-form-body">
            <div class="text-center mb-4">
                <i class="bi bi-calendar2-check booking-form-icon"></i>
                <h3>Event Booking Details</h3>
                <p class="text-muted">Select an event and confirm your booking date</p>
            </div>
            
            <form method="post">
                <div class="mb-4">
                    <label for="EventID" class="booking-form-label">
                        <i class="bi bi-calendar-event me-2"></i>Select Event:
                    </label>
                    <select asp-for="EventID" asp-items="Model.Events" class="form-select form-select-booking">
                        <option value="">-- Select an Event --</option>
                    </select>
                    <span asp-validation-for="EventID" class="text-danger mt-2 d-block"></span>
                </div>
                
                <div class="mb-4">
                    <label for="BookingDate" class="booking-form-label">
                        <i class="bi bi-calendar-date me-2"></i>Booking Date:
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-calendar3"></i>
                        </span>
                        <input asp-for="BookingDate" type="date" class="form-control booking-date-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <span asp-validation-for="BookingDate" class="text-danger mt-2 d-block"></span>
                    <small class="text-muted">The date you are making this booking</small>
                </div>
                
                <div class="booking-form-footer">
                    <button type="submit" class="btn-booking-submit">
                        <i class="bi bi-check-circle me-2"></i>Confirm Booking
                    </button>
                    <a href="/Bookings/List" class="btn btn-outline-secondary ms-3">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>