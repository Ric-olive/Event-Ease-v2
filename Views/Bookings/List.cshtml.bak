@model List<Event_Ease.Models.ViewModels.BookingViewModel>

<div class="bookings-container">
    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="bookings-header">
        <div class="container">
            <h1>Event Bookings Management</h1>
            <p>Comprehensive view of all event bookings with venue details</p>
            <a href="/Bookings/Add" class="btn btn-light mt-3">
                <i class="bi bi-plus-circle me-2"></i>Create New Booking
            </a>
        </div>
    </div>

    <!-- Enhanced Filter Section -->
    <div class="container mb-4">
        <div class="filter-container card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter Bookings</h5>
                <button type="button" class="btn btn-sm btn-link" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="true" aria-controls="filterCollapse">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
            <div class="collapse show" id="filterCollapse">
                <div class="card-body">
                    <form id="searchForm" method="get" action="@Url.Action("List", "Bookings")">
                        <div class="row g-3">
                            <!-- Search Term -->
                            <div class="col-lg-4 col-md-6">
                                <label for="searchTerm" class="form-label small text-muted">Search</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" id="searchTerm" name="searchTerm" class="form-control border-start-0"
                                           placeholder="Event name or booking ID" value="@ViewBag.SearchTerm">
                                </div>
                            </div>
                            
                            <!-- Venue Filter -->
                            <div class="col-lg-4 col-md-6">
                                <label for="venueFilter" class="form-label small text-muted">Venue</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-geo-alt"></i>
                                    </span>
                                    <select id="venueFilter" name="venueFilter" class="form-select border-start-0">
                                        <option value="all" selected="@(ViewBag.VenueFilter == null || ViewBag.VenueFilter == "all")">All Venues</option>
                                        @foreach (var venue in ViewBag.Venues)
                                        {
                                            <option value="@venue" selected="@(ViewBag.VenueFilter == venue)">@venue</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            
                            <!-- Event Type Filter -->
                            <div class="col-lg-4 col-md-6">
                                <label for="eventTypeFilter" class="form-label small text-muted">Event Type</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-tag"></i>
                                    </span>
                                    <select id="eventTypeFilter" name="eventTypeFilter" class="form-select border-start-0">
                                        <option value="all" selected="@(ViewBag.EventTypeFilter == null || ViewBag.EventTypeFilter == "all")">All Event Types</option>
                                        @foreach (var eventType in ViewBag.EventTypes)
                                        {
                                            <option value="@eventType" selected="@(ViewBag.EventTypeFilter == eventType)">@eventType</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            
                            <!-- Status Filter -->
                            <div class="col-lg-4 col-md-6">
                                <label for="statusFilter" class="form-label small text-muted">Status</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-calendar-check"></i>
                                    </span>
                                    <select id="statusFilter" name="statusFilter" class="form-select border-start-0">
                                        <option value="all" selected="@(ViewBag.StatusFilter == null || ViewBag.StatusFilter == "all")">All Statuses</option>
                                        <option value="upcoming" selected="@(ViewBag.StatusFilter == "upcoming")">Upcoming</option>
                                        <option value="in progress" selected="@(ViewBag.StatusFilter == "in progress")">In Progress</option>
                                        <option value="completed" selected="@(ViewBag.StatusFilter == "completed")">Completed</option>
                                    </select>
                                </div>
                            </div>
                            
                            <!-- Start Date Filter -->
                            <div class="col-lg-4 col-md-6">
                                <label for="startDate" class="form-label small text-muted">Start Date</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-calendar-event"></i>
                                    </span>
                                    <input type="date" id="startDate" name="startDate" class="form-control border-start-0"
                                           placeholder="Start Date" value="@(ViewBag.StartDate?.ToString("yyyy-MM-dd"))">
                                </div>
                            </div>
                            
                            <!-- End Date Filter -->
                            <div class="col-lg-4 col-md-6">
                                <label for="endDate" class="form-label small text-muted">End Date</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-calendar-event"></i>
                                    </span>
                                    <input type="date" id="endDate" name="endDate" class="form-control border-start-0"
                                           placeholder="End Date" value="@(ViewBag.EndDate?.ToString("yyyy-MM-dd"))">
                                </div>
                            </div>
                            
                            <!-- Venue Availability Filter -->
                            <div class="col-lg-4 col-md-6">
                                <label for="venueAvailabilityFilter" class="form-label small text-muted">Venue Availability</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="bi bi-check-circle"></i>
                                    </span>
                                    <select id="venueAvailabilityFilter" name="venueAvailabilityFilter" class="form-select border-start-0">
                                        <option value="" selected="@(ViewBag.VenueAvailabilityFilter == null)">Any Availability</option>
                                        <option value="true" selected="@(ViewBag.VenueAvailabilityFilter == true)">Available Venues Only</option>
                                        <option value="false" selected="@(ViewBag.VenueAvailabilityFilter == false)">Unavailable Venues Only</option>
                                    </select>
                                </div>
                            </div>
                            
                            <!-- Apply Filters Button -->
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label small text-muted">&nbsp;</label>
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-filter me-2"></i>Apply Filters
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    <!-- Bookings Cards Section -->
    <div class="container">
        @if (Model.Any())
        {
            <div class="row">
                @foreach (var booking in Model)
                {
                    <div class="col-lg-6 mb-4">
                        <div class="card booking-card h-100">
                            <div class="card-header">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="booking-id-container">
                                        <span class="booking-id">#@booking.BookingID.ToString().Substring(0, 8)</span>
                                    </div>
                                    <div>
                                        @if (booking.IsUpcoming)
                                        {
                                            <span class="status-badge status-upcoming">
                                                <i class="bi bi-clock me-1"></i>
                                                @booking.TimeRemainingDisplay
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center">
                                    <div class="booking-date-badge me-2 mb-1">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        <span>@booking.BookingDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    @if (booking.EventTypeID.HasValue)
                                    {
                                        <div class="event-type-badge mb-1">
                                            <i class="bi bi-tag-fill me-1"></i>
                                            <span>@booking.EventTypeName</span>
                                        </div>
                                    }
                                </div>
                                    else if (booking.IsEventActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-play-fill me-1"></i>
                                            In Progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-completed">
                                            <i class="bi bi-check2-all me-1"></i>
                                            Completed
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="venue-image-container">
                                            <img src="@booking.VenueImageUrl" alt="@booking.VenueName" class="venue-thumbnail">
                                            <div class="venue-capacity">
                                                <i class="bi bi-people-fill me-1"></i>
                                                @booking.VenueCapacity
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <h5 class="booking-event-title">@booking.EventName</h5>
                                        <div class="booking-info-item">
                                            <i class="bi bi-building me-2"></i>
                                            <span class="booking-info-label">Venue:</span>
                                            <span class="booking-info-value">@booking.VenueName</span>
                                        </div>
                                        <div class="booking-info-item">
                                            <i class="bi bi-geo-alt me-2"></i>
                                            <span class="booking-info-label">Location:</span>
                                            <span class="booking-info-value">@booking.VenueLocation</span>
                                        </div>
                                        <div class="booking-info-item">
                                            <i class="bi bi-calendar-range me-2"></i>
                                            <span class="booking-info-label">Event Period:</span>
                                            <span class="booking-info-value">
                                                @booking.EventStartDate.ToString("MMM d") - @booking.EventEndDate.ToString("MMM d, yyyy")
                                                <span class="event-duration">(@booking.EventDurationDisplay)</span>
                                            </span>
                                        </div>
                                        <div class="venue-info">
                                            <i class="bi bi-geo-alt"></i> @booking.VenueName
                                            @if (booking.VenueIsAvailable)
                                            {
                                                <span class="venue-available ms-2"><i class="bi bi-check-circle-fill text-success"></i> Available</span>
                                            }
                                            else
                                            {
                                                <span class="venue-unavailable ms-2"><i class="bi bi-x-circle-fill text-danger"></i> Unavailable</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="event-description mt-3">
                                    <div class="event-description-title">Event Description:</div>
                                    <p>@(booking.EventDescription.Length > 100 ? booking.EventDescription.Substring(0, 100) + "..." : booking.EventDescription)</p>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <div class="booking-id-footer text-muted">
                                    <small>Booking ID: @booking.BookingID</small>
                                </div>
                                <div class="booking-actions">
                                    <a asp-controller="Bookings" asp-action="Edit" asp-route-id="@booking.BookingID" class="btn-booking-edit">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <form asp-controller="Bookings" asp-action="Delete" asp-route-id="@booking.BookingID" method="post"
                                          onsubmit="return confirmDelete('@Html.Raw(Json.Serialize(booking.EventName))');">
                                        <button type="submit" class="btn-booking-delete">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <!-- Pagination Controls (if needed) -->
            @if (Model.Count > 10)
            {
                <div class="d-flex justify-content-center mt-4">
                    <nav aria-label="Booking pages">
                        <ul class="pagination">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x" style="font-size: 3rem; color: #6c757d;"></i>
                <h4 class="mt-3">No Bookings Found</h4>
                <p class="text-muted">
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.VenueFilter != "all" || ViewBag.StatusFilter != "all")
                    {
                        <span>No bookings match your search criteria. Try adjusting your filters.</span>
                        <div class="mt-2">
                            <a href="@Url.Action("List", "Bookings")" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Clear All Filters
                            </a>
                        </div>
                    }
                    else
                    {
                        <span>Create your first booking to get started</span>
                        <div class="mt-2">
                            <a href="/Bookings/Add" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-2"></i>Add First Booking
                            </a>
                        </div>
                    }
                </p>
            </div>
        }
    </div>

    <!-- Floating Add Button -->
    <a href="/Bookings/Add" class="add-booking-btn" title="Add New Booking">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

<!-- Add these CSS rules to your site's stylesheet -->
<style>
    /* Filter Container Styles */
    .filter-container {
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 30px;
        transition: all 0.3s ease;
    }
    
    .filter-container .card-header {
        padding: 15px 20px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
    }
    
    .filter-container .card-body {
        padding: 20px;
        background-color: #fcfcfc;
    }
    
    .filter-container .form-label {
        font-weight: 500;
        margin-bottom: 5px;
    }
    
    .filter-container .input-group-text {
        color: #6c757d;
    }
    
    .filter-container .form-control:focus,
    .filter-container .form-select:focus {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        border-color: #86b7fe;
    }
    
    .filter-container .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
        padding: 10px;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    
    .filter-container .btn-primary:hover {
        background-color: #0b5ed7;
        border-color: #0a58ca;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(13, 110, 253, 0.2);
    }
    
    /* Booking Card Styles */
    .booking-card {
        transition: all 0.3s ease;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }
    
    .booking-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }
    
    .booking-card .card-header {
        background: linear-gradient(to right, #4b6cb7, #182848);
        color: white;
        padding: 15px;
    }
    
    .booking-id-container {
        display: inline-block;
    }
    
    .booking-id {
        font-size: 0.85rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.9);
        background-color: rgba(0, 0, 0, 0.2);
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-block;
    }
    
    .booking-date-badge, .event-type-badge {
        background-color: rgba(255, 255, 255, 0.2);
        color: white;
        font-size: 0.8rem;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        margin-right: 8px;
    }
    
    .booking-date-badge i,
    .event-type-badge i {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-right: 4px;
    }
    
    .event-type-badge {
        background-color: rgba(0, 123, 255, 0.3);
    }
    
    .status-badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }
    
    .status-upcoming {
        background-color: #d1ecf1;
        color: #0c5460;
    }
    
    .status-active {
        background-color: #d4edda;
        color: #155724;
    }
    
    .status-completed {
        background-color: #e2e3e5;
        color: #383d41;
    }
    
    .venue-image-container {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
    }
    
    .venue-thumbnail {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border-radius: 8px;
    }
    
    .venue-capacity {
        position: absolute;
        bottom: 0;
        right: 0;
        background-color: rgba(0, 0, 0, 0.6);
        color: white;
        padding: 5px 10px;
        font-size: 0.8rem;
        border-top-left-radius: 8px;
    }
    
    .booking-event-title {
        font-weight: 700;
        color: #343a40;
        margin-bottom: 10px;
    }
    
    .booking-info-item {
        margin-bottom: 8px;
        font-size: 0.95rem;
    }
    
    .booking-info-label {
        font-weight: 600;
        margin-right: 5px;
        color: #495057;
    }
    
    .event-duration {
        font-size: 0.85rem;
        color: #6c757d;
        margin-left: 5px;
    }
    
    .event-description {
        background-color: #f8f9fa;
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 0.9rem;
    }
    
    .event-description-title {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 5px;
    }
    
    .venue-info {
        font-size: 0.9rem;
        color: #495057;
    }
    
    .venue-available {
        color: #198754;
    }
    
    .venue-unavailable {
        color: #dc3545;
    }
    
    /* Custom Delete Confirmation Dialog Styles */
    .sweet-overlay {
        background-color: rgba(0, 0, 0, 0.6);
    }
    
    .sweet-alert {
        border-radius: 15px;
        font-family: inherit;
        padding: 0;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
    }
    
    .sweet-alert .sa-icon.sa-warning .sa-body,
    .sweet-alert .sa-icon.sa-warning .sa-dot {
        background-color: #dc3545;
    }
    
    .sweet-alert .sa-icon.sa-warning {
        border-color: #dc3545;
    }
    
    .sweet-alert h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 15px 0;
        color: #343a40;
    }
    
    .sweet-alert p {
        color: #6c757d;
        font-size: 1rem;
    }
    
    .sweet-alert .sa-button-container {
        margin-top: 20px;
    }
    
    .sweet-alert button {
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .sweet-alert button.confirm {
        background: linear-gradient(to right, #dc3545, #b21f1f) !important;
        box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3) !important;
    }
    
    .sweet-alert button.confirm:hover {
        background: linear-gradient(to right, #c82333, #a01b1b) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(220, 53, 69, 0.4) !important;
    }
    
    .sweet-alert button.cancel {
        background-color: #6c757d !important;
        color: white !important;
    }
    
    .sweet-alert button.cancel:hover {
        background-color: #5a6268 !important;
    }
    
    .event-name-display {
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 8px;
        border-left: 5px solid #dc3545;
        font-weight: 600;
        color: #343a40;
        margin: 15px 0;
        text-align: center;
    }
</style>

<script>
    // Auto-submit form when filters change
    document.addEventListener('DOMContentLoaded', function() {
        const venueFilter = document.getElementById('venueFilter');
        const statusFilter = document.getElementById('statusFilter');
        const eventTypeFilter = document.getElementById('eventTypeFilter');
        const startDate = document.getElementById('startDate');
        const endDate = document.getElementById('endDate');
        const venueAvailabilityFilter = document.getElementById('venueAvailabilityFilter');
        
        venueFilter.addEventListener('change', function() {
            document.getElementById('searchForm').submit();
        });
        
        statusFilter.addEventListener('change', function() {
            document.getElementById('searchForm').submit();
        });
        
        eventTypeFilter.addEventListener('change', function() {
            document.getElementById('searchForm').submit();
        });
        
        startDate.addEventListener('change', function() {
            document.getElementById('searchForm').submit();
        });
        
        endDate.addEventListener('change', function() {
            document.getElementById('searchForm').submit();
        });
        
        venueAvailabilityFilter.addEventListener('change', function() {
            document.getElementById('searchForm').submit();
        });
        
        // Add delay to search input to prevent too many requests
        const searchInput = document.getElementById('searchTerm');
        let searchTimeout;
        
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function() {
                document.getElementById('searchForm').submit();
            }, 500);
        });
    });
    
    // Make sure to include SweetAlert2 in your _Layout.cshtml
    function loadScript(url) {
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = url;
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
        });
    }
    
    // Load SweetAlert2 if it's not already loaded
    if (typeof Swal === 'undefined') {
        loadScript('https://cdn.jsdelivr.net/npm/sweetalert2@11')
            .catch(error => console.error('Error loading SweetAlert2:', error));
    }
    
    // Custom delete confirmation
    function confirmDelete(eventName) {
        // If SweetAlert2 is not loaded, fallback to browser confirm
        if (typeof Swal === 'undefined') {
            return confirm(`Are you sure you want to delete this booking for '${eventName}'?`);
        }
        
        // Prevent form submission
        event.preventDefault();
        
        // Show SweetAlert2 confirmation
        Swal.fire({
            title: 'Confirm Deletion',
            html: `
                <p>Are you sure you want to delete this booking for:</p>
                <div class="event-name-display">${eventName}</div>
                <p class="mt-3"><i class="bi bi-exclamation-triangle text-warning me-2"></i>This action cannot be undone.</p>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-trash me-2"></i>Delete Booking',
            cancelButtonText: '<i class="bi bi-x-circle me-2"></i>Cancel',
            buttonsStyling: true,
            customClass: {
                confirmButton: 'btn btn-danger',
                cancelButton: 'btn btn-secondary'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                // Submit the form if confirmed
                event.target.closest('form').submit();
            }
        });
        
        return false;
    }
</script>