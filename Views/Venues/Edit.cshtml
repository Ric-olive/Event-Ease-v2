@{
}

@model Event_Ease.Models.Entities.Venue

@if(Model is null) {
    <div class="not-found">
        <h3>Venue Not Found</h3>
        <p>No venue was found with this ID. Please check the ID and try again.</p>
        <a href="/Venues" class="btn btn-primary mt-3">Return to Venues List</a>
    </div>
} else {
    <div class="edit-venue-container">
        <div class="row">
            <div class="col-lg-7">
                <h2 class="edit-title">Edit Venue: @Model.VenueName</h2>
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="VenueID" />
                    <input type="hidden" asp-for="ImageUrl" />
                    
                    <div class="form-group">
                        <label class="form-label">Venue Name</label>
                        <input type="text" class="form-control" asp-for="VenueName" placeholder="Enter venue name">
                        <span asp-validation-for="VenueName" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Venue Location</label>
                        <input type="text" class="form-control" asp-for="Location" placeholder="Enter venue location">
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Venue Capacity</label>
                        <input type="number" class="form-control" asp-for="Capacity" placeholder="Enter maximum capacity">
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Upload New Image (optional)</label>
                        <input type="file" class="form-control" asp-for="ImageFile" accept="image/*" onchange="previewImage(this)">
                        <small class="form-text text-muted">Leave empty to keep the current image</small>
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Venue Description</label>
                        <textarea class="form-control" asp-for="Description" rows="4" placeholder="Enter venue description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <div class="form-check">
                            <input type="checkbox" id="Active" class="form-check-input" asp-for="IsActive">
                            <label class="form-check-label" for="Active">Active Venue</label>
                        </div>
                    </div>
                    
                    <div class="form-group d-flex">
                        <button type="submit" class="btn-edit">Save Changes</button>
                        <a href="/Venues/List" class="btn btn-outline-secondary ms-3 mt-3">Cancel</a>
                    </div>
                </form>
            </div>
            
            <div class="col-lg-5">
                <div class="image-preview-container h-100 d-flex flex-column justify-content-center">
                    <span class="image-preview-title">Current Image</span>
                    <img id="imagePreview" src="@Model.ImageUrl" alt="@Model.VenueName" class="image-preview">
                </div>
            </div>
        </div>
    </div>
}

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            
            reader.onload = function (e) {
                document.getElementById('imagePreview').src = e.target.result;
            }
            
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>