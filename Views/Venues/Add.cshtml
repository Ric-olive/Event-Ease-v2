@{
}

@model Event_Ease.Models.ViewModels.AddVenueViewModel
@await Html.PartialAsync("_ValidationScriptsPartial")
@section Scripts {
    <script>
        // Custom form validation script
        $(document).ready(function () {
            // Show validation messages in a custom alert
            function showValidationAlert(message) {
                var alertHtml = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;

                // Insert at the top of the form
                $(alertHtml).insertBefore('form').hide().fadeIn();

                // Auto-dismiss after 5 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 5000);
            }

            // Custom form submission with validation
            $('form').on('submit', function(e) {
                if (!this.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();

                    // Show a consolidated message
                    showValidationAlert("Please correct the validation errors below.");

                    // Highlight all invalid fields
                    $(this).find(':invalid').each(function() {
                        $(this).addClass('is-invalid');
                        // For accessibility, move focus to the first invalid field
                        if ($(this).is(':first-of-type:invalid')) {
                            $(this).focus();
                        }
                    });
                }

                $(this).addClass('was-validated');
            });

            // Remove invalid class on input when user starts typing
            $('input, select, textarea').on('input change', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}

<head>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</head>

<div class="venue-form-container">
    <div class="row">
        <div class="col-lg-7">
            <h2 class="venue-title">Add New Venue</h2>
            <form method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label class="form-label">Venue Name</label>
                    <input type="text" class="form-control" asp-for="VenueName" required maxlength="100" placeholder="Enter venue name">
                    <span asp-validation-for="VenueName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Venue Location</label>
                    <input type="text" class="form-control" asp-for="Location" required maxlength="100" placeholder="Enter venue location">
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Venue Capacity</label>
                    <input type="number" class="form-control" asp-for="Capacity" required min="1" max="10000" placeholder="Enter maximum capacity">
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Upload Venue Image</label>
                    <input type="file" class="form-control" asp-for="ImageFile" accept="image/*" required onchange="previewImage(this)">
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Venue Description</label>
                    <textarea class="form-control" asp-for="Description" required maxlength="500" rows="4" placeholder="Enter venue description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input type="checkbox" id="Active" class="form-check-input" asp-for="IsActive">
                        <label class="form-check-label" for="Active">Active Venue</label>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn-submit">
                        Create Venue
                    </button>
                    <a href="/Venues/List" class="btn btn-outline-secondary ms-3 mt-3">Cancel</a>
                </div>
            </form>
        </div>

        <div class="col-lg-5">
            <div class="image-preview-container h-100 d-flex flex-column justify-content-center">
                <span class="image-preview-title">Venue Preview</span>
                <img id="imagePreview" src="https://picsum.photos/600/400" alt="Venue Preview" class="image-preview">
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                document.getElementById('imagePreview').src = e.target.result;
            }

            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

