@model List<Event_Ease.Models.Entities.Venue>

<div class="venues-container">
    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="venues-header">
        <div class="container">
            <h1>Explore Our Venues</h1>
            <p>Find the perfect venue for your next event from our collection of premium locations</p>
            <a href="/Venues/Add" class="btn btn-light mt-3">
                <i class="bi bi-plus-circle me-2"></i>Add New Venue
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="container mb-4">
        <div class="filter-container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name">
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-geo-alt"></i>
                        </span>
                        <select id="locationFilter" class="form-control">
                            <option value="" selected>All Locations</option>
                            @{
                                var locations = Model.Select(v => v.Location).Distinct().ToList();
                                foreach (var location in locations)
                                {
                                    <option value="@location">@location</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-people"></i>
                        </span>
                        <select id="capacityFilter" class="form-control">
                            <option value="" selected>All Capacities</option>
                            <option value="1-100">1-100 people</option>
                            <option value="101-500">101-500 people</option>
                            <option value="501-1000">501-1000 people</option>
                            <option value="1001+">1001+ people</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Venues Grid Section -->
    <div class="container">
        @if (Model.Any())
        {
            <div class="row" id="venuesGrid">
                @foreach (var venue in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4 venue-item" 
                         data-name="@venue.VenueName.ToLower()" 
                         data-location="@venue.Location" 
                         data-capacity="@venue.Capacity">
                        <div class="venue-card">
                            <div style="overflow: hidden;">
                                <img src="@venue.ImageUrl" alt="@venue.VenueName" class="card-img-top venue-img">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">@venue.VenueName</h5>
                                <div class="venue-info">
                                    <span class="venue-info-label"><i class="bi bi-geo-alt me-2"></i>Location:</span>
                                    <span>@venue.Location</span>
                                </div>
                                <div class="venue-info">
                                    <span class="venue-info-label"><i class="bi bi-people me-2"></i>Capacity:</span>
                                    <span>@venue.Capacity people</span>
                                </div>
                                <div class="venue-info">
                                    <span class="venue-info-label"><i class="bi bi-info-circle me-2"></i>Description:</span>
                                    <p class="mt-1">@(venue.Description?.Length > 100 ? venue.Description.Substring(0, 100) + "..." : venue.Description)</p>
                                </div>
                                <div>
                                    <span class="venue-status @(venue.IsActive ? "venue-active" : "venue-inactive")">
                                        <i class="bi @(venue.IsActive ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                        @(venue.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-between">
                                <a href="/Venues/Edit/@venue.VenueID" class="btn-edit-card">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form asp-controller="Venues" asp-action="Delete" asp-route-id="@venue.VenueID" method="post" onsubmit="return confirm('Are you sure you want to delete this venue?');">
                                    <button type="submit" class="btn-delete">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-building" style="font-size: 4rem; color: #6c757d;"></i>
                <h3>No Venues Found</h3>
                <p>There are no venues in the system yet. Create your first venue to get started.</p>
                <a href="/Venues/Add" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Add First Venue
                </a>
            </div>
        }
    </div>

    <!-- Floating Add Button -->
    <a href="/Venues/Add" class="add-venue-btn" title="Add New Venue">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

<!-- Filter Logic Script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const locationFilter = document.getElementById('locationFilter');
        const capacityFilter = document.getElementById('capacityFilter');
        const venueItems = document.querySelectorAll('.venue-item');
        
        function filterVenues() {
            const searchTerm = searchInput.value.toLowerCase();
            const locationValue = locationFilter.value;
            const capacityValue = capacityFilter.value;
            
            venueItems.forEach(item => {
                const name = item.dataset.name;
                const location = item.dataset.location;
                const capacity = parseInt(item.dataset.capacity);
                
                let showBySearch = name.includes(searchTerm);
                let showByLocation = locationValue === '' || location === locationValue;
                let showByCapacity = true;
                
                if (capacityValue === '1-100') {
                    showByCapacity = capacity >= 1 && capacity <= 100;
                } else if (capacityValue === '101-500') {
                    showByCapacity = capacity >= 101 && capacity <= 500;
                } else if (capacityValue === '501-1000') {
                    showByCapacity = capacity >= 501 && capacity <= 1000;
                } else if (capacityValue === '1001+') {
                    showByCapacity = capacity >= 1001;
                }
                
                if (showBySearch && showByLocation && showByCapacity) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
        
        searchInput.addEventListener('input', filterVenues);
        locationFilter.addEventListener('change', filterVenues);
        capacityFilter.addEventListener('change', filterVenues);
    });
</script>