@model List<Event_Ease.Models.Entities.Event>
<div class="events-container">
    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <!-- Header Section -->
    <div class="events-header">
        <div class="container">
            <h1>Upcoming Events Calendar</h1>
            <p>Discover and manage all your scheduled events in one place</p>
            <a href="/Events/Add" class="btn btn-light mt-3">
                <i class="bi bi-plus-circle me-2"></i>Create New Event
            </a>
        </div>
    </div>
    <!-- Filter Section -->
    <div class="container mb-4">
        <div class="filter-container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="eventSearchInput" class="form-control" placeholder="Search by event name">
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-geo-alt"></i>
                        </span>
                        <select id="venueFilter" class="form-control">
                            <option value="" selected>All Venues</option>
                            @{
                                var venues = Model
                                    .Where(e => e.Venue != null)
                                    .Select(e => e.Venue.VenueName)
                                    .Distinct()
                                    .ToList();
                                
                                foreach (var venue in venues)
                                {
                                    <option value="@venue">@venue</option>
                                }
                            }
                            <option value="no-venue">No Venue Selected</option>
                        </select>
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-calendar-date"></i>
                        </span>
                        <select id="dateFilter" class="form-control">
                            <option value="" selected>All Dates</option>
                            <option value="upcoming">Upcoming Events</option>
                            <option value="past">Past Events</option>
                            <option value="today">Today's Events</option>
                            <option value="this-week">This Week</option>
                            <option value="this-month">This Month</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Events Table Section -->
    <div class="container">
        <div class="events-table-container">
            <table class="events-table" id="eventsTable">
                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Venue</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var userEvent in Model)
                        {
                            <tr class="event-item"
                                data-name="@userEvent.EventName.ToLower()"
                                data-venue="@(userEvent.Venue != null ? userEvent.Venue.VenueName : "no-venue")"
                                data-start-date="@userEvent.EventStartDate.ToString("yyyy-MM-dd")"
                                data-end-date="@userEvent.EventEndDate.ToString("yyyy-MM-dd")">
                                <td class="event-name">@userEvent.EventName</td>
                                <td class="event-date">
                                    <i class="bi bi-calendar2-check me-2"></i>
                                    @userEvent.EventStartDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="event-date">
                                    <i class="bi bi-calendar2-x me-2"></i>
                                    @userEvent.EventEndDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="event-venue">
                                    @if (userEvent.Venue != null)
                                    {
                                        <i class="bi bi-geo-alt me-2"></i>
                                        @userEvent.Venue.VenueName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="bi bi-x-circle me-2"></i>
                                            No Venue Selected
                                        </span>
                                    }
                                </td>
                                <td class="event-description">
                                    <span title="@userEvent.Description">
                                        @(userEvent.Description?.Length > 30
                                            ? userEvent.Description.Substring(0, 30) + "..."
                                            : userEvent.Description)
                                    </span>
                                </td>
                                <td class="event-actions">
                                    <a asp-controller="Events" asp-action="Edit" asp-route-id="@userEvent.EventID" class="btn-event-edit">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <form asp-controller="Events" asp-action="Delete" asp-route-id="@userEvent.EventID" method="post" id="deleteEventForm-@userEvent.EventID">
                                        <button type="button" class="btn-event-delete" onclick="confirmEventDelete('@userEvent.EventID', '@userEvent.EventName', '@userEvent.EventStartDate.ToString("MMM dd")', '@userEvent.EventEndDate.ToString("MMM dd, yyyy")')">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-calendar-x" style="font-size: 3rem; color: #6c757d;"></i>
                                <h4 class="mt-3">No Events Found</h4>
                                <p class="text-muted">Create your first event to get started</p>
                                <a href="/Events/Add" class="btn btn-primary mt-2">
                                    <i class="bi bi-plus-circle me-2"></i>Add First Event
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- Floating Add Button -->
    <a href="/Events/Add" class="add-event-btn" title="Add New Event">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

<!-- SweetAlert2 Script -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('eventSearchInput');
        const venueFilter = document.getElementById('venueFilter');
        const dateFilter = document.getElementById('dateFilter');
        const eventItems = document.querySelectorAll('.event-item');
        
        function filterEvents() {
            const searchTerm = searchInput.value.toLowerCase();
            const venueValue = venueFilter.value;
            const dateValue = dateFilter.value;
            const today = new Date().toISOString().split('T')[0];
            
            eventItems.forEach(item => {
                const name = item.dataset.name;
                const venue = item.dataset.venue;
                const startDate = item.dataset.startDate;
                const endDate = item.dataset.endDate;
                
                let showBySearch = name.includes(searchTerm);
                let showByVenue = venueValue === '' || venue === venueValue;
                let showByDate = true;
                
                // Date filtering logic
                if (dateValue === 'upcoming') {
                    showByDate = startDate >= today;
                } else if (dateValue === 'past') {
                    showByDate = endDate < today;
                } else if (dateValue === 'today') {
                    showByDate = startDate <= today && endDate >= today;
                } else if (dateValue === 'this-week') {
                    const nextWeek = new Date();
                    nextWeek.setDate(nextWeek.getDate() + 7);
                    const nextWeekStr = nextWeek.toISOString().split('T')[0];
                    showByDate = startDate >= today && startDate <= nextWeekStr;
                } else if (dateValue === 'this-month') {
                    const nextMonth = new Date();
                    nextMonth.setMonth(nextMonth.getMonth() + 1);
                    const nextMonthStr = nextMonth.toISOString().split('T')[0];
                    showByDate = startDate >= today && startDate <= nextMonthStr;
                }
                
                if (showBySearch && showByVenue && showByDate) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }
        
        searchInput.addEventListener('input', filterEvents);
        venueFilter.addEventListener('change', filterEvents);
        dateFilter.addEventListener('change', filterEvents);
    });
    
    // Event Delete Confirmation
    function confirmEventDelete(eventId, eventName, startDate, endDate) {
        Swal.fire({
            title: 'Delete Event',
            html: `
                <div class="text-center mb-4">
                    <div class="event-delete-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                </div>
                <p class="mb-2">Are you sure you want to delete this event?</p>
                <div class="event-name-display">${eventName}</div>
                <div class="event-date-display">
                    <i class="bi bi-calendar-range me-2"></i>${startDate} - ${endDate}
                </div>
                <p class="event-delete-warning mt-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    This action cannot be undone.
                </p>
                <p class="event-delete-note">
                    Events with active bookings cannot be deleted.
                </p>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-trash me-2"></i>Delete Event',
            cancelButtonText: '<i class="bi bi-x-circle me-2"></i>Cancel',
            confirmButtonColor: '#fd7e14', // Orange color to match event theme
            cancelButtonColor: '#6c757d',
            customClass: {
                popup: 'event-delete-popup',
                confirmButton: 'btn-event-confirm-delete',
                cancelButton: 'btn-event-cancel-delete'
            },
            buttonsStyling: true
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById(`deleteEventForm-${eventId}`).submit();
            }
        });
    }
</script>

<style>
    /* SweetAlert2 Event Delete Confirmation Styles */
    .event-delete-popup {
        border-radius: 15px;
        padding-bottom: 20px;
    }
    
    .event-delete-icon {
        width: 80px;
        height: 80px;
        background-color: rgba(253, 126, 20, 0.1);
        border-radius: 50%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: pulse-orange 1.5s infinite;
    }
    
    .event-delete-icon i {
        font-size: 2.5rem;
        color: #fd7e14;
    }
    
    .event-name-display {
        padding: 10px 15px;
        background-color: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #fd7e14;
        font-weight: 600;
        color: #343a40;
        margin: 15px 0 10px;
        text-align: center;
    }
    
    .event-date-display {
        padding: 8px 15px;
        background-color: #fff8f0;
        border-radius: 8px;
        color: #e96b08;
        font-weight: 500;
        text-align: center;
        margin: 0 auto 15px;
        display: inline-block;
    }
    
    .event-delete-warning {
        color: #dc3545;
        font-size: 0.9rem;
        text-align: center;
    }
    
    .event-delete-note {
        color: #6c757d;
        font-size: 0.85rem;
        font-style: italic;
        text-align: center;
    }
    
    .btn-event-confirm-delete {
        background: linear-gradient(to right, #fd7e14, #e96b08);
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .btn-event-confirm-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(253, 126, 20, 0.4);
    }
    
    .btn-event-cancel-delete {
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .btn-event-cancel-delete:hover {
        transform: translateY(-2px);
    }
    
    /* Override SweetAlert styles for event theme */
    .swal2-title {
        color: #343a40 !important;
        font-size: 1.5rem !important;
    }
    
    .swal2-html-container {
        margin-top: 0.5em !important;
    }
    
    .swal2-icon.swal2-warning {
        border-color: #fd7e14 !important;
        color: #fd7e14 !important;
    }
</style>